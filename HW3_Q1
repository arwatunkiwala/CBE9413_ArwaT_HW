def download_wind_data(lat, lon, year):
    """Download wind data from NREL API"""
    wkt = f"POINT({lon} {lat})"
    url = 'https://developer.nrel.gov/api/wind-toolkit/v2/wind/wtk-download.csv'
    
    attributes = [
        'windspeed_100m',
        'relativehumidity_2m',
        'temperature_100m',
        'pressure_100m',
    ]
    
    params = {
        'api_key': api_key,
        'wkt': wkt,
        'names': str(year),
        'interval': '60',
        'utc': 'true',
        'leap_day': 'false',
        'email': email,
        'full_name': full_name,
        'affiliation': affiliation,
        'reason': reason,
        'attributes': ','.join(attributes)
    }
    
    print(f"Downloading data for ({lat}, {lon})...")
    response = requests.get(url, params=params)
    
    if response.status_code != 200:
        print(f"✗ Error downloading data: {response.text}")
        return None
    
    filename = f'wind_100m_{lat}_{lon}_{year}.csv'
    with open(filename, 'w', encoding='utf-8') as f:
        f.write(response.text)
    print(f"✓ Saved to {filename}")
    
    return filename

def process_wind_data(filename):
    """Load and preprocess wind data"""
    df = pd.read_csv(filename, skiprows=1)
    
    df.columns = [c.strip() for c in df.columns]
    df.rename(columns={
        'wind speed at 100m (m/s)': 'v_meas',
        'relative humidity at 2m (%)': 'rh',
        'air temperature at 100m (C)': 'T_C',
        'air pressure at 100m (Pa)': 'p_meas'
    }, inplace=True)
    
    # Calculate air density
    T_K = df['T_C'] + 273.15
    phi = df['rh'] / 100.0
    p_water = phi * 610.78 * np.exp((17.27 * df['T_C']) / (df['T_C'] + 237.3))
    
    R_dry = 287.1
    R_water = 461.5
    n_meas = (df['p_meas'] - p_water) / (R_dry * T_K) + p_water / (R_water * T_K)
    
    # Correct wind speed to standard air density
    n_std = 1.225
    v_std = df['v_meas'] * (n_meas / n_std) ** (1/3)
    
    return v_std, T_K, df

def calculate_turbine_output(v_std, T_K, turbine_params):
    """Calculate turbine power output with hysteresis"""
    rated_power_kw = turbine_params['rated_power_kw']
    cut_in_speed = turbine_params['cut_in_speed']
    cut_out_speed = turbine_params['cut_out_speed']
    reentry_margin = turbine_params['reentry_margin']
    turbine_loss = turbine_params['turbine_loss']
    cf_curve_file = turbine_params['cf_curve_file']
    
    # Load power curve
    cf_curve = pd.read_csv(cf_curve_file, sep=',')
    spline = CubicSpline(
        cf_curve["wind_speed"],
        cf_curve["capacity_factor"],
        bc_type='natural'
    )
    
    # Hysteresis logic
    first_v = v_std.iloc[0]
    state = 1 if first_v <= cut_out_speed else 0
    states = []
    reentry_speed = cut_out_speed - reentry_margin
    
    for v in v_std:
        if state == 1 and v > cut_out_speed:
            state = 0
        elif state == 0 and v < reentry_speed:
            state = 1
        states.append(state)
    
    turbine_state = pd.Series(states, index=v_std.index)
    
    # Calculate power output
    power_output = pd.Series(spline(v_std), index=v_std.index)
    power_output = power_output.clip(lower=0, upper=1)
    power_output = power_output.where(v_std >= cut_in_speed, 0)
    power_output = power_output.where(v_std <= cut_out_speed, 0)
    power_output = power_output.where(T_K >= Temperature_cutoff, 0)
    power_output = power_output * turbine_state
    power_output = power_output * (1 - turbine_loss)
    
    return power_output

