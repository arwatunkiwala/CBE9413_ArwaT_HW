"""Interpolates the capacity factor (CF) for a given wind speed."""
function get_capacity_factor(wind_speed::Float64, turbine_id::Int64, cf_curves::Dict)::Float64
    df = cf_curves[turbine_id]
    # Assumes the first column is speed and the second is CF
    wind_speeds = Float64.(df[:, 1])
    capacity_factors = Float64.(df[:, 2])
    
    # Check boundaries
    if wind_speed <= wind_speeds[1]
        return 0.0
    elseif wind_speed >= wind_speeds[end]
        return capacity_factors[end]
    else
        # Find the interval for interpolation
        idx = searchsortedlast(wind_speeds, wind_speed)
        ws1, ws2 = wind_speeds[idx], wind_speeds[idx+1]
        cf1, cf2 = capacity_factors[idx], capacity_factors[idx+1]
        
        # Linear interpolation
        return ws2 == ws1 ? cf1 : cf1 + (wind_speed - ws1) / (ws2 - ws1) * (cf2 - cf1)
    end
end

"""Loads wind speed data for all specified locations for a given year."""
function load_wind_speed_data(location_ids::Vector{Int}, year::Int)
    wind_speed_data = Dict()
    println("\nLoading wind speed data for year $year...")
    
    for loc_id in location_ids
        details = LOCATION_DETAILS[loc_id]
        lat, lon = details.coords
        
        # Construct the file name using the dynamic pattern
        filename = replace(WIND_FILE_PATTERN, 
                           "{LAT}" => string(lat), 
                           "{LON}" => string(lon), 
                           "{YEAR}" => string(year))
        
        try
            # Attempt to read the file
            lines = readlines(filename)
            # Assuming the CSV has 2 header lines before the data begins
            data_lines = lines[3:end] 
            wind_speeds = Float64[]
            
            for line in data_lines
                # The wind speed value is expected at the 6th position (index 6)
                parts = split(line, ',')
                if length(parts) >= 6
                    try
                        ws = parse(Float64, strip(parts[6])) 
                        push!(wind_speeds, ws)
                    catch e
                        # Skip if line cannot be parsed (e.g., bad data)
                    end
                end
            end
            wind_speed_data[loc_id] = wind_speeds
            println("  ✓ Loc $loc_id ($(details.name)): $(length(wind_speeds)) hours loaded.")
        
        catch e
            # If any file operation fails, print the error and re-throw the exception
            println("  ❌ FILE ERROR for Loc $loc_id, Year $year. Could not open or read: $filename")
            println("  Error details: $e")
            rethrow(e) # Stop execution for this year if a file is missing
        end
    end
    
    # Determine the number of hours (should be consistent, e.g., 8760 or 8784)
    num_hours = isempty(wind_speed_data) ? 0 : length(first(values(wind_speed_data)))
    return wind_speed_data, num_hours
end

# ============================================================================
# OPTIMIZATION FUNCTION
# ============================================================================
"""Runs the optimization model for a single weather year."""
function run_optimization_scenario(location_ids::Vector{Int}, year::Int, turbine_models::Dict, cf_curves::Dict)
    
    wind_speed_data, num_hours = load_wind_speed_data(location_ids, year)
    
    if num_hours == 0
        println("❌ Optimization skipped for Year $year: No wind data loaded. This usually indicates a critical file error.")
        # Returning a "Data Error" status here to distinguish from Gurobi's INFEASIBLE status
        return Dict("Weather_Year" => year, "Total_Capacity_MW" => NaN, "Curtailed_Fraction" => NaN, "Optimization_Status" => "Data Error")
    end

    # Pre-compute capacity factors for all hours, locations, and turbines
    cf_data = Dict()
    for loc in location_ids, turbine in 1:3, h in 1:num_hours
        cf_data[(loc, turbine, h)] = get_capacity_factor(wind_speed_data[loc][h], turbine, cf_curves)
    end
    
    # Build model
    model = Model(Gurobi.Optimizer)
    set_optimizer_attribute(model, "OutputFlag", 0) # Suppress Gurobi output
    set_optimizer_attribute(model, "TimeLimit", 600)
    set_optimizer_attribute(model, "MIPGap", 0.01)

    # Decision Variables
    @variable(model, y[loc in location_ids, 1:3], Bin) # Binary: Is turbine type t chosen at location loc?
    @variable(model, n[loc in location_ids, 1:3] >= 0, Int) # Integer: Number of turbines of type t at location loc

    # C1: At most one turbine model per location
    @constraint(model, [loc in location_ids], sum(y[loc, t] for t in 1:3) <= 1)
    
    # C2: Limit number of turbines to MAX_TURBINES only if that type is selected (linking constraints)
    @constraint(model, [loc in location_ids, t in 1:3], n[loc, t] <= MAX_TURBINES * y[loc, t])
    
    # C3: Meet 100 MW of electricity demand for each hour of the year
    @constraint(model, Power_Balance[h=1:num_hours], 
        sum(n[loc, t] * turbine_models[t].rated_power * cf_data[(loc, t, h)] 
            for loc in location_ids, t in 1:3) >= DEMAND_MW
    )

    # Objective: Minimize total installed capacity (MW)
    @objective(model, Min, 
        sum(n[loc, t] * turbine_models[t].rated_power for loc in location_ids, t in 1:3)
    )

    optimize!(model)

    # Process Results
    if termination_status(model) in [MOI.OPTIMAL, MOI.LOCALLY_SOLVED]
        total_installed_capacity = objective_value(model)
        
        # Calculate curtailment
        total_available_energy = 0.0
        total_curtailed_energy = 0.0
        
        for h in 1:num_hours
            # Total generation available in hour h
            gen = sum(value(n[loc, t]) * turbine_models[t].rated_power * cf_data[(loc, t, h)] 
                     for loc in location_ids, t in 1:3)
            
            total_available_energy += gen
            # Curtailed energy is the surplus above the fixed demand
            total_curtailed_energy += max(0, gen - DEMAND_MW)
        end
        
        curtailed_fraction = total_curtailed_energy / total_available_energy
        
        return Dict(
            "Weather_Year" => year,
            "Total_Capacity_MW" => total_installed_capacity,
            "Curtailed_Fraction" => curtailed_fraction,
            "Optimization_Status" => string(termination_status(model))
        )
    else
        # If optimization fails (e.g., INFEASIBLE, TIME_LIMIT), report the failure status
        return Dict(
            "Weather_Year" => year,
            "Total_Capacity_MW" => NaN,
            "Curtailed_Fraction" => NaN,
            "Optimization_Status" => string(termination_status(model))
        )
    end
end

