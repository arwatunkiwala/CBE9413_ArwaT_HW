P_solar_cap = 400.0
P_wind_cap = 400.0
P_fossil_cap = 800.0
P_fossil_min = 160.0

a = -1e-06
b = 1.2e-03
c = 1.30
d = 200.0
a1 = 2e-07
b1 = 1e-03
c1 = 1.15
d1 = 215.2

fuel_cost = 4.0
loadshed_cost = 1000.0

println("   Fossil plant capacity: $P_fossil_cap MW")
println("   Fossil plant minimum: $P_fossil_min MW")
println("   Solar capacity: $P_solar_cap MW")
println("   Wind capacity: $P_wind_cap MW")
println("   Fuel cost: $fuel_cost \$/MMBtu")
println("   Load shedding cost: $loadshed_cost \$/MWh")

# ============================================================================
# 3. DEFINE TRUE FUEL CONSUMPTION FUNCTION
# ============================================================================
println("\n3. Defining true fuel consumption function...")
println("-"^80)

function alpha_f(P)
    if P < 160.0
        return 0.0
    elseif 160.0 <= P <= 400.0
        return (a + b) * P^2 + c * P + d
    elseif 400.0 < P <= 800.0
        return a1 * P^3 + b1 * P^2 + c1 * P + d1
    else
        return 0.0
    end
end

println("   Fuel consumption function α_f(P) defined")

# ============================================================================
# 4. CREATE PIECEWISE-LINEAR APPROXIMATION (6 SEGMENTS)
# ============================================================================
println("\n4. Creating piecewise-linear approximation...")
println("-"^80)

n_segments = 6
P_breakpoints = collect(range(P_fossil_min, P_fossil_cap, length=n_segments+1))
alpha_breakpoints = [alpha_f(P) for P in P_breakpoints]

println("   Number of segments: $n_segments")
println("\n   Breakpoint values:")
for i in 1:length(P_breakpoints)
    @printf("   P = %6.1f MW → α_f = %7.2f MMBtu/h\n", P_breakpoints[i], alpha_breakpoints[i])
end

# ============================================================================
# 5. OPTIMIZATION MODEL WITH PIECEWISE-LINEAR APPROXIMATION
# ============================================================================
function solve_dispatch_pwl(demand, cf_solar, cf_wind)
    println("\n" * "="^80)
    println("Solving with Piecewise-Linear Approximation ($n_segments segments)")
    println("="^80)

    model = Model(Gurobi.Optimizer)
    set_optimizer_attribute(model, "OutputFlag", 1)
    set_optimizer_attribute(model, "TimeLimit", 600)
    set_optimizer_attribute(model, "MIPGap", 0.01)

    println("   Creating variables...")

    @variable(model, 0 <= P_solar[t=1:T] <= P_solar_cap * cf_solar[t])
    @variable(model, 0 <= P_wind[t=1:T] <= P_wind_cap * cf_wind[t])
    @variable(model, P_fossil[t=1:T] >= 0)
    @variable(model, 0 <= L_shed[t=1:T] <= demand[t])
    @variable(model, u_fossil[t=1:T], Bin)
    @variable(model, 0 <= lambda[t=1:T, i=1:n_segments+1] <= 1)
    @variable(model, alpha[t=1:T] >= 0)

    println("   Adding constraints...")

    @constraint(model, power_balance[t=1:T],
        P_solar[t] + P_wind[t] + P_fossil[t] + L_shed[t] == demand[t])
    @constraint(model, fossil_min[t=1:T],
        P_fossil[t] >= P_fossil_min * u_fossil[t])
    @constraint(model, fossil_max[t=1:T],
        P_fossil[t] <= P_fossil_cap * u_fossil[t])

    for t in 1:T
        @constraint(model, sum(lambda[t, i] for i in 1:n_segments+1) == u_fossil[t])
        @constraint(model, P_fossil[t] == sum(P_breakpoints[i] * lambda[t, i] for i in 1:n_segments+1))
        @constraint(model, alpha[t] == sum(alpha_breakpoints[i] * lambda[t, i] for i in 1:n_segments+1))
        @constraint(model, lambda[t, :] in SOS2())
    end

    @objective(model, Min,
        sum(fuel_cost * alpha[t] + loadshed_cost * L_shed[t] for t in 1:T))

    println("   Starting optimization...")
    optimize!(model)

    status = termination_status(model)
    println("\n   Termination status: $status")

    if status == MOI.OPTIMAL || status == MOI.LOCALLY_SOLVED
        obj_value = objective_value(model)
        solve_time_val = solve_time(model)
        println("   Optimal solution found!")
        @printf("   Solve time: %.2f seconds\n", solve_time_val)
        @printf("   Total operational cost: \$%.2f\n", obj_value)

        P_s = value.(P_solar)
        P_w = value.(P_wind)
        P_f = value.(P_fossil)
        L_s = value.(L_shed)
        alpha_vals = value.(alpha)
        u_vals = value.(u_fossil)

        @printf("   Total load shedding: %.2f MWh\n", sum(L_s))
        @printf("   Total fuel consumption: %.2f MMBtu\n", sum(alpha_vals))
        @printf("   Fossil plant operating hours: %d/%d\n", sum(u_vals .> 0.5), T)

        return Dict(
            "status" => status,
            "objective" => obj_value,
            "P_solar" => P_s,
            "P_wind" => P_w,
            "P_fossil" => P_f,
            "L_shed" => L_s,
            "alpha" => alpha_vals,
            "u_fossil" => u_vals,
            "demand" => demand,
            "solve_time" => solve_time_val
        )
    else
        println("   Optimization failed: $status")
        return nothing
    end
end

