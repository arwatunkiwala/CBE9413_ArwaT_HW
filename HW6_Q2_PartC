        for i in 1:n_segments
            if P_breakpoints[i] <= P <= P_breakpoints[i+1]
                w = (P - P_breakpoints[i]) / (P_breakpoints[i+1] - P_breakpoints[i])
                return (1 - w) * alpha_breakpoints[i] + w * alpha_breakpoints[i+1]
            end
        end
        return alpha_f(P)
