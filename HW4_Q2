function annualize_capital_cost(capital_cost, discount_rate, lifetime)
    """Convert capital cost to annualized cost"""
    crf = (discount_rate * (1 + discount_rate)^lifetime) / 
          ((1 + discount_rate)^lifetime - 1)
    return capital_cost * crf
end

function optimize_storage(battery_type, params, wind_gen, prices, n_hours)
    """
    Optimize storage capacity and operation for a given battery technology
    """
    println("\n", "="^60)
    println("Optimizing $(battery_type) battery storage...")
    println("="^60)
    
    # Create model with Gurobi
    model = Model(Gurobi.Optimizer)
    set_optimizer_attribute(model, "OutputFlag", 1)  # Show Gurobi output
    set_optimizer_attribute(model, "TimeLimit", 300)  # 5 minute time limit
    
    # Decision variables - CAPACITY
    @variable(model, P >= params[:min_power])  # Power capacity [MW]
    @variable(model, E >= 0)  # Energy capacity [MWh]
    
    # Decision variables - OPERATION (indexed from 1 to n_hours for Julia)
    @variable(model, C[1:n_hours] >= 0)  # Charging power [MW]
    @variable(model, D[1:n_hours] >= 0)  # Discharging power [MW]
    @variable(model, S[1:n_hours] >= 0)  # State of charge [MWh]
    @variable(model, y[1:n_hours], Bin)  # Binary variable: 1 = discharge, 0 = charge
    
    # Parameters
    eta_c = params[:charging_eff]
    eta_d = params[:discharging_eff]
    eta_loss = params[:self_discharge]
    alpha_c = params[:charging_cost]
    alpha_d = params[:discharging_cost]
    delta_min = params[:min_soc]
    delta_max = params[:max_soc]
    
    # Objective: Maximize profit
    # Profit = Wind revenue + Battery arbitrage - Wind O&M - Battery capital costs
    
    # Wind revenue (sell all generated wind at market prices)
    wind_revenue = @expression(model,
        sum(prices[t] * wind_gen[t] for t in 1:n_hours)
    )
    
    # Battery operational profit (arbitrage)
    battery_profit = @expression(model,
        sum((prices[t] - alpha_d) * D[t] - (prices[t] + alpha_c) * C[t] for t in 1:n_hours)
    )
    
    # Annualized capital cost
    power_capital = @expression(model, P * params[:power_cost] * 1000)  # Convert to $
    energy_capital = @expression(model, E * params[:energy_cost] * 1000)  # Convert to $
    
    # Calculate CRF
    crf = (discount_rate * (1 + discount_rate)^params[:lifetime]) / 
          ((1 + discount_rate)^params[:lifetime] - 1)
    
    annual_capital = @expression(model, crf * (power_capital + energy_capital))
    
    # Wind O&M cost (in $)
    annual_wind_om_cost = annual_wind_om * 1e6  # Convert from million $ to $
    
    # Total profit
    @objective(model, Max, wind_revenue + battery_profit - annual_capital - annual_wind_om_cost)
    
    # Constraints
    
    # 1. Power capacity constraint: C_t + D_t <= P
    @constraint(model, power_capacity[t=1:n_hours], 
                C[t] + D[t] <= P)
    
    # 1b. Binary constraints to prevent simultaneous charging and discharging
    @constraint(model, charge_binary[t=1:n_hours],
                C[t] <= P * (1 - y[t]))  # Can only charge when y[t] = 0
    @constraint(model, discharge_binary[t=1:n_hours],
                D[t] <= P * y[t])  # Can only discharge when y[t] = 1
    
    # 2. Energy to power ratio constraints
    @constraint(model, min_e_to_p, 
                E >= params[:min_e_to_p] * P)
    @constraint(model, max_e_to_p, 
                E <= params[:max_e_to_p] * P)
    
    # 3. Storage inventory balance
    # Initial time step (t=1): S[1] = (1 - eta_loss) * S_0 + eta_c * C[1] - D[1] / eta_d
    # Assuming S_0 = 0
    @constraint(model, storage_balance_initial,
                S[1] == (1 - eta_loss) * 0 + eta_c * C[1] - D[1] / eta_d)
    
    # Subsequent time steps
    @constraint(model, storage_balance[t=2:n_hours],
                S[t] == (1 - eta_loss) * S[t-1] + eta_c * C[t] - D[t] / eta_d)
    
    # 4. SOC limits
    @constraint(model, min_soc_constraint[t=1:n_hours],
                S[t] >= delta_min * E)
    @constraint(model, max_soc_constraint[t=1:n_hours],
                S[t] <= delta_max * E)
    
    # 5. Final SOC constraint (end at reasonable level)
    @constraint(model, final_soc,
                S[n_hours] >= 0)
    
    # Solve
    println("Solving optimization problem...")
    optimize!(model)
    
    # Check solver status
    if termination_status(model) != MOI.OPTIMAL
        println("Warning: Solver did not find optimal solution.")
        println("Status: ", termination_status(model))
    else
        println("Optimization successful!")
    end
    
    # Extract results
    P_opt = value(P)
    E_opt = value(E)
    profit_opt = objective_value(model)
    
    C_opt = [value(C[t]) for t in 1:n_hours]
    D_opt = [value(D[t]) for t in 1:n_hours]
    S_opt = [value(S[t]) for t in 1:n_hours]
    
    # Calculate metrics
    duration = eta_d * E_opt / P_opt  # hours
    annual_energy_supply = sum(D_opt)  # MWh
    num_cycles = E_opt > 0 ? annual_energy_supply / E_opt : 0
    
    return Dict(
        :model => model,
        :P_opt => P_opt,
        :E_opt => E_opt,
        :profit_opt => profit_opt,
        :C_opt => C_opt,
        :D_opt => D_opt,
        :S_opt => S_opt,
        :duration => duration,
        :num_cycles => num_cycles
    )
end

