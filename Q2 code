# PLOT 2: STACKED AREA PLOT FOR DISPATCH
function plot_dispatch(result, title_suffix)
    P_vals = result.P
    wind_vals = result.wind_dispatch
    
    # Create stacked area data
    p = plot(xlabel="Hour", ylabel="Power (MW)", 
             title="Generator Dispatch - $title_suffix",
             legend=:outertopright, size=(900, 500))
    
    # Plot each thermal generator as stacked area
    gen_names = thermal_data[!, "Name"]
    for g in 1:n_gen
        if g == 1
            plot!(p, 1:T, P_vals[g,:], fillrange=0, 
                  label=gen_names[g], alpha=0.7, linewidth=0)
        else
            cumsum_prev = sum(P_vals[1:g-1,:], dims=1)[:]
            cumsum_curr = cumsum_prev .+ P_vals[g,:]
            plot!(p, 1:T, cumsum_curr, fillrange=cumsum_prev,
                  label=gen_names[g], alpha=0.7, linewidth=0)
        end
    end
    
    # Add wind on top
    cumsum_thermal = sum(P_vals, dims=1)[:]
    cumsum_total = cumsum_thermal .+ wind_vals
    plot!(p, 1:T, cumsum_total, fillrange=cumsum_thermal,
          label="Wind", alpha=0.7, linewidth=0, color=:green)
    
    # Add demand line
    plot!(p, 1:T, demand, label="Demand", linewidth=2, 
          color=:black, linestyle=:dash)
    
    return p
end

