using CSV, DataFrames
using JuMP, Gurobi
using Plots
using Statistics

# ---------------------------------------------------------------------------
# FILE PATHS
gen_path = "/content/q2_generator_data-2.csv"
demand_path = "/content/q2_demand_cf.csv"

# ---------------------------------------------------------------------------
# READ CSV FILES
gen_data = CSV.read(gen_path, DataFrame)
demand_cf_data = CSV.read(demand_path, DataFrame)

# ---------------------------------------------------------------------------
# FIX GENERATOR CSV
# Rename the generator name column
rename!(gen_data, "Column1" => "Name")

# SAFE RAMP-RATE CLEANING (works with "-", Int64, String, missing)
gen_data[!, "Ramp rate (MW/h)"] = [
    x == "-" ? 9999.0 : parse(Float64, string(x))
    for x in gen_data[!, "Ramp rate (MW/h)"]
]

# ---------------------------------------------------------------------------
# DETECT AND SEPARATE WIND GENERATOR
wind_row = findfirst(x -> occursin(r"(?i)wind", x), gen_data[!, "Name"])

if wind_row === nothing
    error("No wind generator found — cannot detect wind capacity.")
end

wind_capacity = gen_data[wind_row, "MaxCap (MW)"]
print("Detected wind capacity = ")
print(wind_capacity)
println(" MW")

# Create thermal-only generator data (excluding wind)
thermal_indices = setdiff(1:nrow(gen_data), wind_row)
thermal_data = gen_data[thermal_indices, :]

# ---------------------------------------------------------------------------
# EXTRACT THERMAL GENERATOR DATA
P_max = Float64.(thermal_data[!, "MaxCap (MW)"])
P_min = Float64.(thermal_data[!, "Min Output (MW)"])
mc    = Float64.(thermal_data[!, "Marginal Cost (d_p_MWh)"])
startup_cost = Float64.(thermal_data[!, "Startup cost (d)"])
ramp_rate    = Float64.(thermal_data[!, "Ramp rate (MW/h)"])

n_gen = length(P_max)
print("Number of thermal generators = ")
println(n_gen)

# ---------------------------------------------------------------------------
# READ DEMAND + WIND CF
demand = Float64.(demand_cf_data[!, "Load"])
wind_cf = Float64.(demand_cf_data[!, "WindCF"])
T = length(demand)

wind_available = wind_capacity .* wind_cf

# ---------------------------------------------------------------------------
# MODEL SOLVING FUNCTIONS

function solve_dispatch(use_ramping::Bool)
    model = Model(Gurobi.Optimizer)
    set_optimizer_attribute(model, "OutputFlag", 0)

    @variable(model, P[1:n_gen, 1:T] >= 0)
    @variable(model, u[1:n_gen, 1:T], Bin)
    @variable(model, v[1:n_gen, 1:T], Bin)
    @variable(model, w[1:n_gen, 1:T], Bin)
    @variable(model, 0 <= wind_dispatch[1:T] <= wind_capacity)
    @variable(model, wind_curtail[1:T] >= 0)

    @objective(model, Min,
        sum(mc[g] * P[g,t] for g=1:n_gen, t=1:T) +
        sum(startup_cost[g] * v[g,t] for g=1:n_gen, t=1:T)
    )

    # Supply-demand balance
    @constraint(model, balance[t=1:T],
        sum(P[g,t] for g in 1:n_gen) + wind_dispatch[t] == demand[t]
    )

    # Generator limits
    for g in 1:n_gen, t in 1:T
        @constraint(model, P[g,t] <= P_max[g] * u[g,t])
        @constraint(model, P[g,t] >= P_min[g] * u[g,t])
    end

    # Wind availability
    @constraint(model, [t=1:T],
        wind_dispatch[t] + wind_curtail[t] == wind_available[t]
    )

    # Startup/shutdown logic with cyclic constraint (t=0 state = t=24 state)
    for g in 1:n_gen
        # First hour: compare with last hour (t=24) for cyclic constraint
        @constraint(model, v[g,1] >= u[g,1] - u[g,T])
        @constraint(model, w[g,1] >= u[g,T] - u[g,1])

        for t in 2:T
            @constraint(model, v[g,t] >= u[g,t] - u[g,t-1])
            @constraint(model, w[g,t] >= u[g,t-1] - u[g,t])
        end
    end

    @constraint(model, [g=1:n_gen, t=1:T], v[g,t] + w[g,t] <= 1)

    # RAMPING CONSTRAINTS
    if use_ramping
        for g in 1:n_gen
            # Ramping between consecutive hours
            for t in 2:T
                @constraint(model, P[g,t] - P[g,t-1] <= ramp_rate[g])
                @constraint(model, P[g,t-1] - P[g,t] <= ramp_rate[g])
            end
            
            # Cyclic ramping: between t=24 and t=1
            @constraint(model, P[g,1] - P[g,T] <= ramp_rate[g])
            @constraint(model, P[g,T] - P[g,1] <= ramp_rate[g])
        end
    end

    optimize!(model)

    return (
        cost = objective_value(model),
        P = value.(P),
        u = value.(u),
        v = value.(v),
        w = value.(w),
        wind_dispatch = value.(wind_dispatch),
        wind_curtail = value.(wind_curtail),
        model = model
    )
end

# ---------------------------------------------------------------------------
# PRICE EXTRACTION
function get_prices(result)
    ufix = round.(Int, value.(result.u))

    lp = Model(Gurobi.Optimizer)
    set_optimizer_attribute(lp, "OutputFlag", 0)

    @variable(lp, P[1:n_gen, 1:T] >= 0)
    @variable(lp, 0 <= wind_dispatch[1:T] <= wind_capacity)
    @variable(lp, wind_curtail[1:T] >= 0)

    @objective(lp, Min, sum(mc[g] * P[g,t] for g=1:n_gen, t=1:T))

    @constraint(lp, balance_lp[t=1:T],
        sum(P[g,t] for g in 1:n_gen) + wind_dispatch[t] == demand[t]
    )

    for g in 1:n_gen, t in 1:T
        @constraint(lp, P[g,t] <= P_max[g] * ufix[g,t])
        @constraint(lp, P[g,t] >= P_min[g] * ufix[g,t])
    end

    @constraint(lp, [t=1:T],
        wind_dispatch[t] + wind_curtail[t] == wind_available[t]
    )

    optimize!(lp)

    return dual.(balance_lp)
end

