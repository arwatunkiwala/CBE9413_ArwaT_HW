# ============================================================================
# 4. HELPER FUNCTION: COMPUTE ReLU BOUNDS
# ============================================================================
function compute_relu_bounds(W1, b1, P_min, P_max, P_mean, P_std)
    z0_min = (P_min - P_mean) / P_std
    z0_max = (P_max - P_mean) / P_std

    n_neurons = length(b1)
    z_hat_min = zeros(Float32, n_neurons)
    z_hat_max = zeros(Float32, n_neurons)

    for i in 1:n_neurons
        if W1[i] >= 0
            z_hat_min[i] = W1[i] * z0_min + b1[i]
            z_hat_max[i] = W1[i] * z0_max + b1[i]
        else
            z_hat_min[i] = W1[i] * z0_max + b1[i]
            z_hat_max[i] = W1[i] * z0_min + b1[i]
        end
    end

    return z_hat_min, z_hat_max
end

# ============================================================================
# 5. OPTIMIZATION MODEL
# ============================================================================
function solve_dispatch(model_name, W1, b1, W2, b2, demand, cf_solar, cf_wind)
    println("\n" * "="^80)
    println("Solving with $model_name")
    println("="^80)

    n_neurons = length(b1)
    println("   Architecture: 1 input → $n_neurons neurons (ReLU) → 1 output")

    # Create model
    model = Model(Gurobi.Optimizer)
    set_optimizer_attribute(model, "OutputFlag", 1)
    set_optimizer_attribute(model, "TimeLimit", 600)
    set_optimizer_attribute(model, "MIPGap", 0.01)

    println("   Creating variables...")

    # Generator outputs
    @variable(model, 0 <= P_solar[t=1:T] <= P_solar_cap * cf_solar[t])
    @variable(model, 0 <= P_wind[t=1:T] <= P_wind_cap * cf_wind[t])
    @variable(model, P_fossil[t=1:T])
    @variable(model, 0 <= L_shed[t=1:T] <= demand[t])

    # Fossil plant on/off status
    @variable(model, u_fossil[t=1:T], Bin)

    # Neural network variables
    @variable(model, z0[t=1:T])
    @variable(model, z_hat1[t=1:T, i=1:n_neurons])
    @variable(model, z1[t=1:T, i=1:n_neurons] >= 0)
    @variable(model, y1[t=1:T, i=1:n_neurons], Bin)
    @variable(model, alpha_normalized[t=1:T])
    @variable(model, alpha[t=1:T])

    println("   Adding constraints...")

    # Power balance
    @constraint(model, power_balance[t=1:T],
        P_solar[t] + P_wind[t] + P_fossil[t] + L_shed[t] == demand[t])

    # Fossil plant bounds with binary on/off
    @constraint(model, fossil_min[t=1:T],
        P_fossil[t] >= P_fossil_min * u_fossil[t])
    @constraint(model, fossil_max[t=1:T],
        P_fossil[t] <= P_fossil_cap * u_fossil[t])

    # Compute ReLU bounds
    z_hat_min, z_hat_max = compute_relu_bounds(W1, b1, P_fossil_min, P_fossil_cap, P_mean, P_std)

    println("   ReLU bounds computed:")
    for i in 1:min(3, n_neurons)
        @printf("     Neuron %d: [%.3f, %.3f]\n", i, z_hat_min[i], z_hat_max[i])
    end

    # Neural Network Constraints
    for t in 1:T
        # Input normalization
        @constraint(model, z0[t] == (P_fossil[t] - P_mean) / P_std)

        # Layer 1: Linear transformation
        for i in 1:n_neurons
            @constraint(model, z_hat1[t,i] == W1[i] * z0[t] + b1[i])
        end

        # Layer 1: ReLU activation (Big-M reformulation)
        for i in 1:n_neurons
            @constraint(model, z1[t,i] >= z_hat1[t,i])
            @constraint(model, z1[t,i] <= z_hat1[t,i] - z_hat_min[i] * (1 - y1[t,i]))
            @constraint(model, z1[t,i] <= z_hat_max[i] * y1[t,i])
        end

        # Output layer: Linear transformation
        @constraint(model, alpha_normalized[t] == sum(W2[i] * z1[t,i] for i in 1:n_neurons) + b2[1])

        # Denormalization
        @constraint(model, alpha[t] == alpha_normalized[t] * alpha_std + alpha_mean)

        # Ensure fuel consumption is non-negative (physical constraint)
        @constraint(model, alpha[t] >= 0)
    end

    # Objective: Minimize total operational cost
    @objective(model, Min,
        sum(fuel_cost * alpha[t] + loadshed_cost * L_shed[t] for t in 1:T))

    println("   Objective: Minimize Σ(4.0 × α[t] + 1000 × L_shed[t])")
    println("   Total variables: $(num_variables(model))")

    println("\n   Starting optimization...")
    optimize!(model)

    status = termination_status(model)
    println("\n   Termination status: $status")

    if status == MOI.OPTIMAL || status == MOI.LOCALLY_SOLVED
        obj_value = objective_value(model)
        solve_time_val = solve_time(model)
        println("   ✓ Optimal solution found!")
        @printf("   Solve time: %.2f seconds\n", solve_time_val)
        @printf("   Total operational cost: \$%.2f\n", obj_value)

        P_s = value.(P_solar)
        P_w = value.(P_wind)
        P_f = value.(P_fossil)
        L_s = value.(L_shed)
        alpha_vals = value.(alpha)
        u_vals = value.(u_fossil)

        total_loadshed = sum(L_s)
        total_fuel = sum(alpha_vals)
        fossil_hours = sum(u_vals .> 0.5)

        @printf("   Total load shedding: %.2f MWh\n", total_loadshed)
        @printf("   Total fuel consumption: %.2f MMBtu\n", total_fuel)
        @printf("   Fossil plant operating hours: %d/24\n", fossil_hours)

        return Dict(
            "status" => status,
            "objective" => obj_value,
            "P_solar" => P_s,
            "P_wind" => P_w,
            "P_fossil" => P_f,
            "L_shed" => L_s,
            "alpha" => alpha_vals,
            "u_fossil" => u_vals,
            "demand" => demand,
            "solve_time" => solve_time_val
        )
    else
        println("   ✗ Optimization failed: $status")
        return nothing
    end
end

