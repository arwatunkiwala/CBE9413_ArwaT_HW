def get_nsrdb_data(lat, lon, year, api_key, email):
    """
    Get solar data - tries NSRDB first, falls back to PVGIS if rate limited
    """
    try:
        print(f"  Downloading NSRDB PSM3 data for {year}...")
        print(f"  Location: {lat}°N, {lon}°W")
        
        # Try pvlib's get_psm3 first
        from pvlib.iotools import get_psm3
        
        data, meta = get_psm3(
            latitude=lat,
            longitude=lon,
            names=str(year),
            api_key=api_key,
            email=email,
            map_variables=True
        )
        
        if 'temp_air' in data.columns:
            data['air_temperature'] = data['temp_air']
        
        print(f"  ✓ Downloaded {len(data)} hours of NSRDB data")
        return data, meta
        
    except Exception as e:
        error_msg = str(e).lower()
        
        if '429' in error_msg or 'rate limit' in error_msg:
            print(f"  ⚠ NSRDB rate limit exceeded")
        else:
            print(f"  ⚠ NSRDB failed: {e}")
        
        # FALLBACK: Use PVGIS (free, no API key, no rate limits!)
        print(f"  → Switching to PVGIS data (free, no API key needed)...")
        
        try:
            from pvlib.iotools import get_pvgis_tmy
            
            # Try new API first (returns 4 values)
            try:
                data, months_selected, inputs, meta = get_pvgis_tmy(
                    latitude=lat,
                    longitude=lon,
                    map_variables=True
                )
            except ValueError:
                # Older pvlib version returns only 2 values
                data, meta = get_pvgis_tmy(
                    latitude=lat,
                    longitude=lon,
                    map_variables=True
                )
            
            # PVGIS uses temp_air, we need air_temperature
            if 'temp_air' in data.columns:
                data['air_temperature'] = data['temp_air']
            
            print(f"  ✓ Downloaded {len(data)} hours of PVGIS TMY data")
            print(f"  Note: Using typical meteorological year (TMY) data")
            
            return data, meta
            
        except Exception as e2:
            print(f"  ✗ PVGIS also failed: {e2}")
            raise ValueError("Both NSRDB and PVGIS failed. Check internet connection.")


def simulate_pv_system(lat, lon, tz, year, api_key, email, is_tracking=False):
    """
    Simulate PV system using pvlib with NSRDB data
    """
    print(f"  Getting NSRDB weather data...")
    
    # Get NSRDB data
    data, meta = get_nsrdb_data(lat, lon, year, api_key, email)
    
    # Create location object
    location = Location(latitude=lat, longitude=lon, tz=tz)
    
    # Module and inverter parameters
    module_params = {'pdc0': module_power, 'gamma_pdc': -0.004}
    SystemCapacityDC = module_power * modules_per_string * strings_per_inverter
    inverter_params = {
        'pdc0': SystemCapacityDC / DC_AC_RATIO,
        'eta_inv_nom': 1 - inverter_nom_loss
    }
    
    # Define mounting
    if is_tracking:
        mount = SingleAxisTrackerMount(
            axis_tilt=0,
            axis_azimuth=180,
            backtrack=True,
            gcr=0.33,
            max_angle=60.0
        )
    else:
        surface_tilt = abs(lat)
        mount = FixedMount(
            surface_tilt=surface_tilt,
            surface_azimuth=180
        )
    
    # Define array
    array = Array(
        mount=mount,
        module='pvwatts_dc',
        module_parameters=module_params,
        modules_per_string=modules_per_string,
        strings=strings_per_inverter,
        temperature_model_parameters=pvlib.temperature.TEMPERATURE_MODEL_PARAMETERS['sapm']['open_rack_glass_glass']
    )
    
    # Define system
    system = PVSystem(
        arrays=[array],
        inverter_parameters=inverter_params,
        losses_parameters=losses
    )
    
    # Run model
    mc = ModelChain(
        system, location,
        aoi_model='physical',
        spectral_model='no_loss',
        dc_model='pvwatts',
        ac_model='pvwatts',
        temperature_model='sapm',
        transposition_model='perez',
        losses_model='pvwatts'
    )
    
    mc.run_model(weather=data)
    
    # Scale to plant capacity
    NumberofSystems = DC_CAPACITY_MW / (SystemCapacityDC / 1e6)
    ac_output_mw = mc.results.ac / 1e6 * NumberofSystems
    
    # Calculate capacity factor
    annual_gen_mwh = ac_output_mw.sum()
    capacity_factor = annual_gen_mwh / (AC_CAPACITY_MW * HOURS_PER_YEAR)
    
    print(f"  Annual generation: {annual_gen_mwh:,.0f} MWh")
    print(f"  Capacity factor: {capacity_factor:.1%}")
    
    return annual_gen_mwh, capacity_factor


def calculate_lcoe(annual_gen_mwh, capital_cost, annual_om, incentive_type='none'):
    """
    Calculate Levelized Cost of Energy (LCOE)
    """
    
    # Adjust capital cost for ITC
    if incentive_type == 'ITC':
        capital_cost_adjusted = capital_cost * (1 - ITC_RATE)
    else:
        capital_cost_adjusted = capital_cost
    
    # Initialize NPV calculations
    npv_costs = capital_cost_adjusted
    npv_generation = 0
    npv_ptc_revenue = 0
    
    # Calculate NPV over project lifetime
    for year_num in range(1, LIFETIME + 1):
        discount_factor = 1 / (1 + DISCOUNT_RATE) ** year_num
        
        # Generation degrades each year
        degradation_factor = (1 - DEGRADATION_RATE) ** (year_num - 1)
        generation_this_year = annual_gen_mwh * degradation_factor
        
        # Add discounted O&M costs
        npv_costs += annual_om * discount_factor
        
        # Add discounted generation
        npv_generation += generation_this_year * discount_factor
        
        # Add PTC revenue (first 10 years only)
        if incentive_type == 'PTC' and year_num <= PTC_DURATION:
            ptc_revenue = generation_this_year * PTC_RATE
            npv_ptc_revenue += ptc_revenue * discount_factor
    
    # LCOE calculation
    lcoe = (npv_costs - npv_ptc_revenue) / npv_generation
    
    return lcoe


def analyze_scenario(location_key, loc_info, is_tracking, year, api_key, email):
    """Run complete analysis for one scenario"""
    
    system_type = "tracking" if is_tracking else "fixed"
    
    print(f"\n{'='*70}")
    print(f"Scenario: {loc_info['name']} - {system_type}")
    print(f"{'='*70}")
    
    # Simulate PV system
    annual_gen_mwh, capacity_factor = simulate_pv_system(
        loc_info['lat'], loc_info['lon'], loc_info['tz'], 
        year, api_key, email, is_tracking
    )
    
    # Calculate costs
    if is_tracking:
        capital_cost = CAPITAL_COST_TRACKING * AC_CAPACITY_MW * 1000
        annual_om = OM_TRACKING * AC_CAPACITY_MW * 1000
    else:
        capital_cost = CAPITAL_COST_FIXED * AC_CAPACITY_MW * 1000
        annual_om = OM_FIXED * AC_CAPACITY_MW * 1000
    
    # Calculate LCOE under both incentives
    lcoe_itc = calculate_lcoe(annual_gen_mwh, capital_cost, annual_om, 'ITC')
    lcoe_ptc = calculate_lcoe(annual_gen_mwh, capital_cost, annual_om, 'PTC')
    
    print(f"  Capital cost: ${capital_cost/1e6:.2f}M")
    print(f"  Annual O&M: ${annual_om/1e3:.0f}k")
    print(f"  LCOE with ITC: ${lcoe_itc:.2f}/MWh")
    print(f"  LCOE with PTC: ${lcoe_ptc:.2f}/MWh")
    print(f"  Better incentive: {'ITC' if lcoe_itc < lcoe_ptc else 'PTC'}")
    
    return {
        'Location': loc_info['name'],
        'System': system_type.capitalize(),
        'CF (%)': f"{capacity_factor*100:.1f}",
        'Annual Gen (MWh)': f"{annual_gen_mwh:,.0f}",
        'Capital ($M)': f"{capital_cost/1e6:.2f}",
        'Annual O&M ($k)': f"{annual_om/1e3:.0f}",
        'LCOE - ITC ($/MWh)': f"{lcoe_itc:.2f}",
        'LCOE - PTC ($/MWh)': f"{lcoe_ptc:.2f}",
        'Lower LCOE': 'ITC' if lcoe_itc < lcoe_ptc else 'PTC',
        'annual_gen_mwh': annual_gen_mwh,
        'capacity_factor': capacity_factor,
        'capital_cost': capital_cost,
        'annual_om': annual_om,
        'lcoe_itc': lcoe_itc,
        'lcoe_ptc': lcoe_ptc
    }


