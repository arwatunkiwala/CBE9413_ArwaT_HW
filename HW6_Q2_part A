# Define the original piecewise nonlinear fuel consumption function
function alpha_f(P)
    if 160 <= P <= 400
        a, b, c, d = -1e-6, 1.2e-3, -1.30, 200
        return a*P^3 + b*P^2 + c*P + d
    elseif 400 < P <= 800
        a1, b1, c1, d1 = -2e-7, 1e-3, -1.15, 215.2
        return a1*P^3 + b1*P^2 + c1*P + d1
    else
        error("P must be in range [160, 800]")
    end
end

# Generate data points
function generate_data(n_points=200)
    P_values = range(160, 800, length=n_points)
    alpha_values = [alpha_f(P) for P in P_values]
    return Float32.(collect(P_values)), Float32.(alpha_values)
end

# Split data into training and validation
function split_data(P, alpha, train_ratio=0.8)
    n_total = length(P)
    n_train = Int(floor(n_total * train_ratio))
    
    indices = randperm(n_total)
    train_idx = indices[1:n_train]
    val_idx = indices[n_train+1:end]
    
    return P[train_idx], alpha[train_idx], P[val_idx], alpha[val_idx]
end

# Create neural network model
function create_model(n_hidden)
    return Chain(
        Dense(1, n_hidden, relu),
        Dense(n_hidden, 1)
    )
end

# Train the model
function train_model(model, X_train, y_train, X_val, y_val; epochs=10000)
    # Setup optimizer
    opt = Flux.setup(Flux.Adam(0.001), model)
    
    # Training loop
    train_losses = Float64[]
    val_losses = Float64[]
    
    for epoch in 1:epochs
        # Training step
        grads = Flux.gradient(model) do m
            pred = m(X_train)
            Flux.mse(pred, y_train)
        end
        
        Flux.update!(opt, model, grads[1])
        
        # Track losses
        train_loss = Flux.mse(model(X_train), y_train)
        push!(train_losses, train_loss)
        
        # Validation loss
        val_loss = Flux.mse(model(X_val), y_val)
        push!(val_losses, val_loss)
        
        # Print progress
        if epoch % 1000 == 0 || epoch == 1
            println("Epoch $epoch: Train Loss = $(round(train_loss, digits=6)), Val Loss = $(round(val_loss, digits=6))")
        end
    end
    
    return train_losses, val_losses
end

